<?xml version="1.0" encoding="utf-8"?>
<!-- Settings and saved sessions (finalized transcripts, filesDir/sessions) never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="sessions/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="sessions/" />
    </device-transfer>
</data-extraction-rules>
