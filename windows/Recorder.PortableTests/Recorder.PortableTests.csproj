<Project Sdk="Microsoft.NET.Sdk">
  <!-- Model-free checks that run on Windows and Linux: language/model switch stress against Recorder.FakeNative (real BackendCore + NativeEngine + NativeClient) and the on-demand CUDA runtime installer against a local HTTP server. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><EnableWindowsTargeting>true</EnableWindowsTargeting></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Recorder.Backend/Recorder.Backend.csproj" /></ItemGroup>
</Project>
